index 0000000000000000000000000000000000000000..4bb84e7e0e422ebe6339a1788e3e1e3b69d49b81
--- /dev/null
+++ b/src/app/shared/utils/artifact-download.ts
@@ -0,0 +1,39 @@
+import {convertToReverseProxy, isFileserverUrl} from './url';
+
+export class ArtifactDownloadHttpError extends Error {
+  constructor(public readonly status: number) {
+    super(`Artifact download failed: HTTP ${status}`);
+  }
+}
+
+export const artifactNavigationUrl = (source: string): string => {
+  const url = new URL(convertToReverseProxy(source), window.location.href);
+  if (isFileserverUrl(url.href) && !url.searchParams.has('download')) {
+    // Append without reserializing signed/encoded query parameters.
+    url.search += (url.search ? '&' : '?') + 'download=';
+  }
+  return url.href;
+};
+
+export const saveArtifactResponse = async (response: Response, source: string): Promise<void> => {
+  if (!response.ok) {
+    throw new ArtifactDownloadHttpError(response.status);
+  }
+  const header = response.headers.get('Content-Disposition') || '';
+  const encodedName = /filename\*=UTF-8''([^;]+)/i.exec(header)?.[1];
+  const plainName = /filename=(?:"([^"]*)"|([^;]*))/i.exec(header);
+  let name = plainName?.[1] || plainName?.[2]?.trim();
+  try {
+    name = encodedName ? decodeURIComponent(encodedName) : name;
+    name ||= decodeURIComponent(new URL(source, window.location.href).pathname.split('/').pop());
+  } catch {}
+  const objectUrl = window.URL.createObjectURL(await response.blob());
+  try {
+    const anchor = document.createElement('a');
+    anchor.href = objectUrl;
+    anchor.download = (name || 'artifact').replace(/[/\\]/g, '_');
+    anchor.click();
+  } finally {
+    window.setTimeout(() => window.URL.revokeObjectURL(objectUrl), 1000);
+  }
+};
