+:host {
+  display: block;
+  height: 100%;
+  min-height: 0;
+  overflow: auto;
+  color: var(--color-on-surface);
+}
+
+.data-page {
+  max-width: 1120px;
+  margin: 0 auto;
+  padding: 24px;
+}
+
+.panels {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 16px;
+}
+
+section {
+  background: var(--color-surface-container-lowest);
+  border: 1px solid var(--color-outline-variant);
+  border-radius: 8px;
+  padding: 20px;
+}
+
+h2 { font-size: 18px; margin: 0 0 12px; }
+h3 { font-size: 15px; margin: 0 0 4px; }
+p { margin: 10px 0; }
+label { display: block; margin: 10px 0 4px; }
+input, select { display: block; max-width: 100%; margin-top: 4px; }
+input[type=number], select {
+  padding: 6px 8px;
+  border: 1px solid var(--color-outline);
+  border-radius: 4px;
+  background: var(--color-surface);
+  color: inherit;
+}
+.checkbox { display: flex; align-items: center; gap: 8px; margin-bottom: 16px; }
+.checkbox input { margin: 0; }
+.options, .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
+.options input { width: 145px; }
+.catalog { margin-top: 16px; }
+.catalog-heading, .dataset { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
+.catalog-heading h2 { margin: 0; }
+.dataset { border-top: 1px solid var(--color-outline-variant); padding: 12px 0; }
+.selection { padding: 12px 0; }
+.selection span { display: block; }
+code { overflow-wrap: anywhere; color: inherit; }
+.error { color: var(--color-error); }
+a { color: var(--color-primary); }
+
+@media (max-width: 850px) {
+  .panels { grid-template-columns: minmax(0, 1fr); }
+}
diff --git a/src/app/features/data-preparation/data-preparation.component.ts b/src/app/features/data-preparation/data-preparation.component.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9f5366a52096fc4bc7909b4ffc5615262615d4fe
--- /dev/null
+++ b/src/app/features/data-preparation/data-preparation.component.ts
@@ -0,0 +1,293 @@
+import {ChangeDetectionStrategy, Component, DestroyRef, inject, signal} from '@angular/core';
+import {FormsModule} from '@angular/forms';
+import {MatButtonModule} from '@angular/material/button';
+import {RouterLink} from '@angular/router';
+import {saveArtifactResponse} from '~/shared/utils/artifact-download';
+
+type Statistics = {
+  unique_records: number;
+  duplicates_removed: number;
+  train_records: number;
+  validation_records: number;
+};
+
+type PreparationOptions = {seed: number; validation_fraction: number};
+
+type RequestRecord = {
+  request_id: string;
+  filename: string;
+  status: string;
+  pending?: string;
+  error?: string;
+  input_dataset_id?: string;
+  input_version?: string;
+  processing_task_id?: string;
+  task_project?: string;
+  output_dataset_id?: string;
+  output_version?: string;
+  manifest_sha256?: string;
+  submitted_parameters?: PreparationOptions;
+  submitted?: boolean;
+  statistics?: Statistics;
+};
+
+type Selection = {id: string; version: string; manifest_sha256: string};
+type PreparedDataset = Selection & {name: string; project: string; statistics: Statistics};
+type Bootstrap = {
+  user: {id: string};
+  requests: RequestRecord[];
+  selected: Selection | null;
+  max_bytes: number;
+};
+
+const API = '/data-entry/api';
+const errorText = (error: unknown) => error instanceof Error ? error.message : String(error);
+
+@Component({
+  standalone: true,
+  templateUrl: './data-preparation.component.html',
+  styleUrl: './data-preparation.component.scss',
+  changeDetection: ChangeDetectionStrategy.OnPush,
+  imports: [FormsModule, MatButtonModule, RouterLink],
+})
+export class DataPreparationComponent {
+  private readonly destroyRef = inject(DestroyRef);
+  private readonly refreshTimer: number;
+  private userId = '';
+  private refreshing = false;
+
+  readonly requests = signal<RequestRecord[]>([]);
+  readonly current = signal<RequestRecord | null>(null);
+  readonly datasets = signal<PreparedDataset[]>([]);
+  readonly selected = signal<Selection | null>(null);
+  readonly error = signal('');
+  readonly statusError = signal('');
+  readonly catalogError = signal('');
+  readonly busy = signal(false);
+  readonly ready = signal(false);
+  readonly maxBytes = signal(1048576);
+  readonly file = signal<File | null>(null);
+  synthetic = false;
+  seed: number | null = 42;
+  validationFraction: number | null = 0.25;
+
+  constructor() {
+    void this.load();
+    this.refreshTimer = window.setInterval(() => {
+      const status = this.current()?.status;
+      if (status && ['created', 'queued', 'in_progress'].includes(status)) {
+        void this.refresh();
+      }
+    }, 3000);
+    this.destroyRef.onDestroy(() => window.clearInterval(this.refreshTimer));
+  }
+
+  private async api<T>(path: string, body?: object): Promise<T> {
+    const response = await this.request(path, body);
+    return response.json() as Promise<T>;
+  }
+
+  private async request(path: string, body?: object): Promise<Response> {
+    const response = await fetch(API + path, body ? {
+      method: 'POST',
+      headers: {'Content-Type': 'application/json', 'X-TieSheAI-Request': '1'},
+      body: JSON.stringify(body),
+    } : {});
+    if (!response.ok) {
+      const detail = await response.json().catch(() => ({}));
+      const message = detail.error || (response.status === 401 ? '请登录 ClearML' : '请求失败（HTTP ' + response.status + '）');
+      let validation: {errors?: {line: number}[]} = {};
+      try {
+        validation = JSON.parse(message);
+      } catch {
+        // The adapter also returns plain text for non-validation errors.
+      }
+      if (validation.errors?.length) {
+        const lines = validation.errors.slice(0, 20).map(item => item.line).join('、');
+        const suffix = validation.errors.length > 20 ? '等 ' + validation.errors.length + ' 行' : '行';
+        throw new Error('第 ' + lines + ' ' + suffix + '不符合 conversation-v1 格式');
+      }
+      throw new Error(message);
+    }
+    return response;
+  }
+
+  private async load() {
+    try {
+      const state = await this.api<Bootstrap>('/bootstrap');
+      this.userId = state.user.id;
+      this.requests.set(state.requests);
+      this.selected.set(state.selected);
+      this.maxBytes.set(state.max_bytes);
+      this.ready.set(true);
+      const previous = localStorage.getItem(this.storageKey('active'));
+      const record = state.requests.find(item => item.request_id === previous) || state.requests[0];
+      if (record) {
+        this.setCurrent(record);
+        void this.refresh();
+      }
+      await this.loadCatalog();
+    } catch (error) {
+      this.error.set(errorText(error));
+    }
+  }
+
+  private storageKey(name: string) {
+    return 'tiesheai-data-preparation:' + this.userId + ':' + name;
+  }
+
+  private setCurrent(record: RequestRecord) {
+    this.current.set(record);
+    localStorage.setItem(this.storageKey('active'), record.request_id);
+    this.requests.update(records => records.some(item => item.request_id === record.request_id)
+      ? records.map(item => item.request_id === record.request_id ? record : item)
+      : [record, ...records]);
+  }
+
+  async loadCatalog() {
+    try {
+      this.catalogError.set('');
+      const data = await this.api<{datasets: PreparedDataset[]}>('/catalog');
+      this.datasets.set(data.datasets);
+    } catch (error) {
+      this.catalogError.set(errorText(error));
+    }
+  }
+
+  chooseFile(event: Event) {
+    this.file.set((event.target as HTMLInputElement).files?.[0] ?? null);
+    this.error.set('');
+  }
+
+  async upload() {
+    const file = this.file();
+    if (!file || this.busy()) {
+      return;
+    }
+    this.busy.set(true);
+    this.error.set('');
+    try {
+      if (!file.name.toLowerCase().endsWith('.jsonl')) {
+        throw new Error('请选择 .jsonl 文件');
+      }
+      if (!file.size || file.size > this.maxBytes()) {
+        throw new Error(file.size ? '文件超过 1 MiB 限制' : '文件为空');
+      }
+      const bytes = new Uint8Array(await file.arrayBuffer());
+      const hash = await crypto.subtle.digest('SHA-256', bytes);
+      const fingerprint = JSON.stringify([
+        Array.from(new Uint8Array(hash), byte => byte.toString(16).padStart(2, '0')).join(''),
+        file.name,
+        this.synthetic,
+      ]);
+      const key = this.storageKey('upload');
+      const saved = JSON.parse(localStorage.getItem(key) || 'null');
+      const requestId: string = saved?.fingerprint === fingerprint ? saved.id : crypto.randomUUID();
+      localStorage.setItem(key, JSON.stringify({id: requestId, fingerprint}));
+      let binary = '';
+      for (let offset = 0; offset < bytes.length; offset += 8192) {
+        binary += String.fromCharCode(...bytes.subarray(offset, offset + 8192));
+      }
+      const record = await this.api<RequestRecord>('/upload', {
+        request_id: requestId, filename: file.name, synthetic_fixture: this.synthetic, content_base64: btoa(binary),
+      });
+      this.setCurrent(record);
+      this.seed = record.submitted_parameters?.seed ?? 42;
+      this.validationFraction = record.submitted_parameters?.validation_fraction ?? 0.25;
+    } catch (error) {
+      this.error.set(errorText(error));
+    } finally {
+      this.busy.set(false);
+    }
+  }
+
+  async submit() {
+    const current = this.current();
+    if (!current || this.busy()) {
+      return;
+    }
+    this.error.set('');
+    const seed = this.seed;
+    const fraction = this.validationFraction;
+    if (seed === null || !Number.isInteger(seed) || seed < -2147483648 || seed > 2147483647) {
+      this.error.set('seed 必须为 32 位整数');
+      return;
+    }
+    if (fraction === null || !(fraction > 0 && fraction < 1)) {
+      this.error.set('验证组比例必须大于 0 且小于 1');
+      return;
+    }
+    this.busy.set(true);
+    try {
+      this.setCurrent(await this.api<RequestRecord>('/submit', {
+        request_id: current.request_id, seed, validation_fraction: fraction,
+      }));
+    } catch (error) {
+      this.error.set(errorText(error));
+    } finally {
+      this.busy.set(false);
+      void this.refresh();
+    }
+  }
+
+  switchRequest(id: string) {
+    const record = this.requests().find(item => item.request_id === id);
+    if (record) {
+      this.error.set('');
+      this.seed = record.submitted_parameters?.seed ?? 42;
+      this.validationFraction = record.submitted_parameters?.validation_fraction ?? 0.25;
+      this.setCurrent(record);
+      void this.refresh();
+    }
+  }
+
+  async refresh() {
+    const previous = this.current();
+    if (!previous || this.refreshing || this.busy()) {
+      return;
+    }
+    this.refreshing = true;
+    try {
+      const record = await this.api<RequestRecord>('/requests/' + previous.request_id);
+      if (this.current()?.request_id === previous.request_id && !this.busy()) {
+        this.setCurrent(record);
+        this.statusError.set('');
+        if (record.status === 'completed' && previous.status !== 'completed') {
+          void this.loadCatalog();
+        }
+      }
+    } catch (error) {
+      this.statusError.set(errorText(error));
+    } finally {
+      this.refreshing = false;
+    }
+  }
+
+  async selectDataset(id: string) {
+    await this.catalogAction(async () => {
+      const result = await this.api<{selected: Selection}>('/select', {dataset_id: id});
+      this.selected.set(result.selected);
+    });
+  }
+
+  async downloadDataset(id: string) {
+    await this.catalogAction(async () => {
+      await saveArtifactResponse(await this.request('/archive', {dataset_id: id}), 'prepared-conversations.zip');
+    });
+  }
+
+  private async catalogAction(action: () => Promise<void>) {
+    if (this.busy()) {
+      return;
+    }
+    this.busy.set(true);
+    this.catalogError.set('');
+    try {
+      await action();
+    } catch (error) {
+      this.catalogError.set(errorText(error));
+    } finally {
+      this.busy.set(false);
+    }
+  }
+}
