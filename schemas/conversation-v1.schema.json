{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tiesheai:conversation:v1",
  "title": "TieSheAI conversation-v1 JSONL record",
  "description": "One UTF-8 JSON object per line. Additional procedural checks in prepare.py enforce optional initial system, alternating user/assistant, final assistant, unique IDs and valid Unicode.",
  "type": "object",
  "required": ["messages"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "\\S"},
    "source_id": {"type": "string", "pattern": "\\S"},
    "messages": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "required": ["role", "content"], "additionalProperties": false,
        "properties": {
          "role": {"enum": ["system", "user", "assistant"]},
          "content": {"type": "string", "pattern": "\\S"}
        }
      }
    }
  }
}
