--- /dev/null
+++ b/src/app/features/data-preparation/data-preparation.component.html
@@ -0,0 +1,93 @@
+<main class="data-page">
+  <h1>数据准备</h1>
+  <div class="panels">
+    <section aria-labelledby="upload-title">
+      <h2 id="upload-title">上传对话数据</h2>
+      <p>选择 UTF-8 conversation-v1 JSONL 文件，最大 1 MiB。每行包含 messages，user 和 assistant 交替，可用 source_id 标记来源组。</p>
+      <label for="conversation-file">JSONL 文件</label>
+      <input id="conversation-file" type="file" accept=".jsonl" (change)="chooseFile($event)" [disabled]="!ready() || busy()">
+      <label class="checkbox"><input type="checkbox" [(ngModel)]="synthetic" [disabled]="busy()">合成测试数据</label>
+      <button mat-flat-button type="button" (click)="upload()" [disabled]="!ready() || !file() || busy()">上传并登记 Dataset</button>
+    </section>
+
+    <section aria-labelledby="process-title">
+      <h2 id="process-title">CPU 处理</h2>
+      @if (current(); as record) {
+        <label for="active-request">最近请求</label>
+        <select id="active-request" [ngModel]="record.request_id" (ngModelChange)="switchRequest($event)" [disabled]="busy()">
+          @for (item of requests(); track item.request_id) {
+            <option [value]="item.request_id">{{item.filename}} · {{item.request_id.slice(0, 8)}}</option>
+          }
+        </select>
+        @if (record.input_dataset_id) {
+          <p>输入 Dataset v{{record.input_version}} <code>{{record.input_dataset_id}}</code></p>
+        }
+        <div class="options">
+          <label for="seed">随机种子 <input id="seed" type="number" [(ngModel)]="seed" [disabled]="!!record.submitted_parameters || busy()"></label>
+          <label for="validation-fraction">验证组比例 <input id="validation-fraction" type="number" step="any" [(ngModel)]="validationFraction" [disabled]="!!record.submitted_parameters || busy()"></label>
+        </div>
+        <p>验证比例按来源组计算。rail-cpu 空闲时接受提交。</p>
+        <div class="actions">
+          <button mat-flat-button type="button" (click)="submit()" [disabled]="busy() || !!record.pending || !!record.submitted || !['uploaded', 'created'].includes(record.status)">提交 CPU 处理</button>
+          <button mat-button type="button" (click)="refresh()" [disabled]="busy()">刷新状态</button>
+        </div>
+        <p role="status" data-id="preparation-status">状态 {{record.status}}</p>
+        @if (record.pending) {
+          <p role="alert">操作结果待核对，请刷新状态或查看已有任务。</p>
+        }
+        @if (record.error || statusError()) {
+          <p class="error" role="alert">{{record.error || statusError()}}</p>
+        }
+        @if (record.processing_task_id && record.task_project) {
+          <div class="actions">
+            <a [routerLink]="['/projects', record.task_project, 'tasks', record.processing_task_id, 'output', 'log']">任务日志</a>
+            <a [routerLink]="['/projects', record.task_project, 'tasks', record.processing_task_id, 'output', 'artifacts']">任务产物</a>
+          </div>
+        }
+        @if (record.status === 'completed' && record.statistics; as stats) {
+          <p data-id="preparation-summary">唯一 {{stats.unique_records}} · 重复 {{stats.duplicates_removed}} · 训练 {{stats.train_records}} · 验证 {{stats.validation_records}}</p>
+          <p>输出 Dataset v{{record.output_version}} <code>{{record.output_dataset_id}}</code></p>
+          <p>Manifest SHA-256 <code>{{record.manifest_sha256}}</code></p>
+        }
+      } @else {
+        <p>上传登记完成后可配置并提交处理。</p>
+      }
+    </section>
+  </div>
+
+  @if (error()) {
+    <p class="error" role="alert" data-id="preparation-error">{{error()}}</p>
+  }
+
+  <section class="catalog" aria-labelledby="catalog-title">
+    <div class="catalog-heading">
+      <h2 id="catalog-title">可选输出 Dataset</h2>
+      <button mat-button type="button" (click)="loadCatalog()" [disabled]="!ready() || busy()">刷新列表</button>
+    </div>
+    @if (selected(); as choice) {
+      <div class="selection" role="status" data-id="selected-dataset">
+        已选 v{{choice.version}} <code>{{choice.id}}</code>
+        <span>Manifest SHA-256 <code>{{choice.manifest_sha256}}</code></span>
+      </div>
+    }
+    @if (catalogError()) {
+      <p class="error" role="alert">{{catalogError()}}</p>
+    }
+    @for (dataset of datasets(); track dataset.id) {
+      <article class="dataset" [attr.data-dataset-id]="dataset.id">
+        <div>
+          <h3>{{dataset.name}} · v{{dataset.version}}</h3>
+          <p>训练 {{dataset.statistics.train_records}} · 验证 {{dataset.statistics.validation_records}}</p>
+          <code>{{dataset.id}}</code>
+        </div>
+        <div class="actions">
+          <a [routerLink]="['/datasets/simple', dataset.project, 'tasks', dataset.id]">查看 Dataset</a>
+          <button mat-button type="button" (click)="downloadDataset(dataset.id)" [disabled]="busy()">下载结果</button>
+          <button mat-stroked-button type="button" (click)="selectDataset(dataset.id)" [disabled]="busy() || selected()?.id === dataset.id">选择 Dataset</button>
+        </div>
+      </article>
+    } @empty {
+      <p>暂无已加载的兼容输出。</p>
+    }
+  </section>
+</main>
